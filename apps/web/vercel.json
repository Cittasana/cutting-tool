{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @cutting-tool/web build",
  "crons": [
    {
      "path": "/api/cron/refresh-meta-tokens",
      "schedule": "0 3 * * *"
    }
  ]
}
